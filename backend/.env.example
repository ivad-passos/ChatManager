# Porta local de desenvolvimento.
# No Render, a porta é injetada automaticamente via process.env.PORT
# (o fallback no código é 3000, conforme regra de deploy).
PORT=3001

# Token de verificação do webhook.
# Você inventa este valor e cadastra o MESMO no painel da Meta
# (Meta for Developers > Seu App > WhatsApp > Configuração > Webhook).
META_VERIFY_TOKEN=troque_por_um_token_secreto

# App Secret do App na Meta for Developers (Configurações > Básico > Chave Secreta do App).
# Usado para validar a assinatura HMAC-SHA256 (header X-Hub-Signature-256) de
# cada requisição do webhook, confirmando que o payload realmente veio da Meta.
# Se deixado vazio, a validação de assinatura é pulada (não recomendado em produção).
META_APP_SECRET=

# Token de acesso da Cloud API (usado pelas rotas de envio POST /messages).
# Em desenvolvimento, use o token temporário de 24h do painel da Meta;
# em produção, gere um token permanente (System User).
META_ACCESS_TOKEN=

# ID do número de telefone na Cloud API
# (Meta for Developers > WhatsApp > Configuração da API > Phone number ID)
META_PHONE_NUMBER_ID=

# Versão da Graph API usada no envio (opcional; padrão: v22.0)
META_GRAPH_API_VERSION=

# URL do frontend na Vercel, para restringir o CORS em produção.
# Em desenvolvimento, deixe vazio para liberar qualquer origem.
FRONTEND_URL=
